{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "small_model": "github-copilot/gpt-5-mini",
  "default_agent": "shelby",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 20000
  },
  "permission": {
    "external_directory": {
      "~/personal/**": "allow",
      "~/company/**": "allow",
      "~/.config/opencode/**": "allow",
      "/tmp/**": "allow",
      "/private/tmp/**": "allow"
    }
  },
  "provider": {
    "github-copilot": {
      "options": {
        "timeout": 1800000,
        "chunkTimeout": 120000
      },
      "models": {
        "claude-opus-4.6": {
          "limit": {
            "context": 144000,
            "input": 144000,
            "output": 64000
          }
        },
        "gpt-5.3-codex": {
          "limit": {
            "context": 400000,
            "input": 400000,
            "output": 128000
          }
        },
        "gpt-5.1-codex-max": {
          "limit": {
            "context": 400000,
            "input": 400000,
            "output": 128000
          }
        },
        "gpt-5.2-codex": {
          "limit": {
            "context": 400000,
            "input": 400000,
            "output": 128000
          }
        },
        "grok-code-fast-1": {
          "limit": {
            "context": 128000,
            "input": 128000,
            "output": 64000
          }
        },
        "gpt-5.1": {
          "limit": {
            "context": 264000,
            "input": 264000,
            "output": 64000
          }
        },
        "claude-sonnet-4.6": {
          "limit": {
            "context": 200000,
            "input": 200000,
            "output": 32000
          }
        },
        "gemini-3-flash-preview": {
          "limit": {
            "context": 128000,
            "input": 128000,
            "output": 64000
          }
        },
        "claude-haiku-4.5": {
          "limit": {
            "context": 144000,
            "input": 144000,
            "output": 32000
          }
        },
        "gpt-5.1-codex-mini": {
          "limit": {
            "context": 400000,
            "input": 400000,
            "output": 128000
          }
        },
        "gpt-5.2": {
          "limit": {
            "context": 264000,
            "input": 264000,
            "output": 64000
          }
        },
        "gpt-4.1": {
          "limit": {
            "context": 128000,
            "input": 128000,
            "output": 16384
          }
        },
        "claude-opus-4.5": {
          "limit": {
            "context": 160000,
            "input": 160000,
            "output": 32000
          }
        },
        "gemini-3.1-pro-preview": {
          "limit": {
            "context": 128000,
            "input": 128000,
            "output": 64000
          }
        },
        "gpt-5.4": {
          "limit": {
            "context": 400000,
            "input": 400000,
            "output": 128000
          }
        },
        "gpt-5.1-codex": {
          "limit": {
            "context": 400000,
            "input": 400000,
            "output": 128000
          }
        },
        "claude-sonnet-4": {
          "limit": {
            "context": 216000,
            "input": 216000,
            "output": 16000
          }
        },
        "claude-sonnet-4.5": {
          "limit": {
            "context": 144000,
            "input": 144000,
            "output": 32000
          }
        },
        "gpt-5-mini": {
          "limit": {
            "context": 264000,
            "input": 264000,
            "output": 64000
          }
        },
        "gemini-2.5-pro": {
          "limit": {
            "context": 128000,
            "input": 128000,
            "output": 64000
          }
        },
        "gpt-4o": {
          "limit": {
            "context": 128000,
            "input": 128000,
            "output": 4096
          }
        },
        "gpt-5.4-mini": {
          "limit": {
            "context": 400000,
            "input": 400000,
            "output": 128000
          }
        }
      }
    }
  },
  "experimental": {
    "disable_paste_summary": true
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--no-usage-statistics",
        "--executablePath",
        "/Applications/Chromium.app/Contents/MacOS/Chromium",
        "--ignoreDefaultChromeArg=--disable-extensions",
        "--chromeArg=--disable-extensions-except=/Users/bytedance/.config/opencode/ublock-origin/uBlock0.chromium",
        "--chromeArg=--load-extension=/Users/bytedance/.config/opencode/ublock-origin/uBlock0.chromium",
        "--chromeArg=--headless=new"
      ]
    }
  },
  "plugin": [
    "opencode-handoff",
    "./plugins/angstrom-levy",
    "./plugins/copilot-stats",
    "./plugins/session-helper",
    "./plugins/worker-generator"
  ]
}
