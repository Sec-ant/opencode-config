{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "small_model": "github-copilot/gpt-5-mini",
  "default_agent": "shelby",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 20000
  },
  "permission": {
    "external_directory": {
      "~/personal/**": "allow",
      "~/company/**": "allow",
      "~/.config/opencode/**": "allow",
      "/tmp/**": "allow",
      "/private/tmp/**": "allow"
    }
  },
  "provider": {
    "github-copilot": {
      "options": {
        "timeout": 1800000
      }
    }
  },
  "experimental": {
    "disable_paste_summary": true
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "bash",
        "/home/secant/.config/opencode/chrome-mcp-wrapper.sh"
      ]
    }
  },
  "plugin": [
    "opencode-handoff@0.5.0",
    "./plugins/angstrom-levy",
    "./plugins/session-helper",
    "./plugins/worker-generator"
  ]
}
