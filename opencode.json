{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "small_model": "github-copilot/gpt-5-mini",
  "default_agent": "shelby",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 20000
  },
  "permission": {
    "external_directory": {
      "~/personal/**": "allow",
      "~/company/**": "allow",
      "~/.config/opencode/**": "allow",
      "/tmp/**": "allow",
      "/private/tmp/**": "allow"
    }
  },
  "provider": {
    "github-copilot": {
      "options": {
        "timeout": 1800000
      }
    }
  },
  "experimental": {
    "disable_paste_summary": true
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@0.21.0",
        "--no-usage-statistics",
        "--executablePath",
        "/Applications/Chromium.app/Contents/MacOS/Chromium",
        "--ignoreDefaultChromeArg=--disable-extensions",
        "--chromeArg=--disable-extensions-except=/Users/bytedance/.config/opencode/ublock-origin/uBlock0.chromium,/Users/bytedance/.config/opencode/meow-header",
        "--chromeArg=--load-extension=/Users/bytedance/.config/opencode/ublock-origin/uBlock0.chromium,/Users/bytedance/.config/opencode/meow-header",
        "--chromeArg=--headless=new",
        "--chromeArg=--no-sandbox",
        "--chromeArg=--user-data-dir=/Users/bytedance/.config/opencode/chromium-mcp"
      ]
    }
  },
  "plugin": [
    "./plugins/angstrom-levy",
    "./plugins/session-helper",
    "./plugins/worker-generator"
  ]
}
